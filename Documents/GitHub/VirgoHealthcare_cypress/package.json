{
  "name": "virgohealthcare-cypress",
  "version": "1.0.0",
  "description": "Cypress automation framework for VirgoHealthcare application",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:edge": "cypress run --browser edge",
    "cy:run:headed": "cypress run --headed",
    "cy:run:spec": "cypress run --spec",
    "test:smoke": "cypress run --env grepTags=@smoke",
    "test:regression": "cypress run --env grepTags=@regression",
    "test:e2e": "cypress run --env grepTags=@e2e",
    "cy:verify": "cypress verify",
    "cy:install": "cypress install",
    "test:ci": "cypress run --record --key",
    "lint": "eslint cypress/**/*.js",
    "lint:fix": "eslint cypress/**/*.js --fix"
  },
  "keywords": [
    "cypress",
    "testing",
    "automation",
    "e2e",
    "virgohealthcare"
  ],
  "author": "VirgoHealthcare QA Team",
  "license": "MIT",
  "devDependencies": {
    "cypress": "^13.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

